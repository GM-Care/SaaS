# ============================================================================
# CINESPACE / PRABHAKAR HOME CINEMA - ENVIRONMENT CONFIGURATION
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
PLATFORM_NAME=CineSpace India - Luxury Private Theaters
BASE_URL=http://localhost:3000

# Razorpay Payment Gateway Credentials (Get from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# Platform Business Model & Commission Rates
PLATFORM_COMMISSION_PERCENT=10.0
PAYMENT_GATEWAY_FEE_PERCENT=2.36
GST_RATE_PERCENT=18.0

# Master Admin Security
ADMIN_PIN=1234
MASTER_ADMIN_EMAIL=admin@cinespace.in

# SMTP Email Dispatch Credentials (Gmail App Password or AWS SES / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="CineSpace Concierge" <noreply@cinespace.in>

# Merchant Default WhatsApp
DEFAULT_SUPPORT_WHATSAPP=+919962279790
